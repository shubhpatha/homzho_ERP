# ── Secrets & Sensitive data ───────────────────────────────────
.env
*.env.local
*.env.production

# ── Database (mount as volume at runtime instead) ──────────────
*.db
*.sqlite
*.sqlite3

# ── Runtime-generated directories (mount as volumes) ──────────
backups/
exports/
logs/
static/uploads/

# ── Python bytecode ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Virtual environment ───────────────────────────────────────
venv/
env/
.venv/

# ── Tests & dev scripts ───────────────────────────────────────
test_*.py
count_ifs.py
backfill_*.py

# ── OS & IDE ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ── Git ───────────────────────────────────────────────────────
.git/
.gitignore

# ── Docker itself ─────────────────────────────────────────────
Dockerfile
docker-compose.yml
.dockerignore

# ── Migrations (schema handled by app startup) ────────────────
migrations/versions/__pycache__/

# ── GCP / CI helpers ─────────────────────────────────────────
.agents/
.codex/
README.md
