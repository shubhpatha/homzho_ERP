# ──────────────────────────────────────────────────────────────
# Homzho ERP — Production Environment Variables
# Fill in real values. NEVER commit this file to git.
# On GCP, prefer injecting these via Secret Manager:
#   gcloud run deploy --set-secrets SECRET_KEY=homzho-secret-key:latest
# ──────────────────────────────────────────────────────────────

# Flask / Security (REQUIRED)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# Backup API protection token (REQUIRED)
BACKUP_TOKEN=CHANGE_THIS_TO_A_RANDOM_TOKEN

# Database — leave blank to use the default SQLite file inside the container.
# For production on GCP, switch to Cloud SQL (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Logging
LOG_LEVEL=error

# Email (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
